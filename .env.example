# MemeVault environment configuration.
# Copy this file to `.env.local` (gitignored, preferred) or `.env`, then fill in real values.
# `.env.local` wins over `.env`; real environment variables win over both.
# Secrets belong ONLY in those files — never in config YAML, the database, or logs (PRD §41).

# OpenRouter API key for AI descriptions/tags and embeddings (PRD §0, §16).
# Leave empty when running tests — the mock provider needs no key.
OPENROUTER_API_KEY=

# Optional overrides for config/config.yaml (leave empty to use YAML defaults).
AI_MODEL=
EMBEDDING_MODEL=

# AI provider: openrouter (default, needs OPENROUTER_API_KEY) or mock (offline demo).
MEME_AI_PROVIDER=

# Structured log level (DEBUG/INFO/WARNING/ERROR/CRITICAL). Default: INFO.
# Logs go to the console and to logs/memevault.log (rotating, gitignored).
MEME_LOG_LEVEL=

# Backend bind address. Localhost only — do not expose publicly (PRD §41).
MEME_HOST=127.0.0.1
MEME_PORT=8000

# Optional: path to an alternate config YAML file (defaults to config/config.yaml).
MEME_CONFIG_PATH=
